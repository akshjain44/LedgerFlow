# ---------------------------------------------------------------- database
# Runtime connection: the restricted `ledgerflow_app` role (Row Level Security
# applies to it). Never use a superuser / table-owner role here.
DATABASE_URL=postgresql://ledgerflow_app:CHANGE_ME@localhost:5432/ledgerflow
# Migration connection: the schema owner (e.g. `postgres`).
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ledgerflow

# ---------------------------------------------------------------- app
APP_URL=http://localhost:3000
# Display name; change to rebrand.
NEXT_PUBLIC_APP_NAME=LedgerFlow
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
# Used to sign time-limited document links.
SESSION_SECRET=
# Bearer token required by /api/cron/reminders.
CRON_SECRET=

# ---------------------------------------------------------------- file storage
# Private directory for uploaded documents (outside /public). On serverless
# hosts use a persistent volume, or implement the StorageProvider interface
# in src/server/storage.ts for S3 / Supabase Storage.
STORAGE_DIR=./storage

# ---------------------------------------------------------------- email (optional)
# Without these, in-app notifications still work and email deliveries are
# recorded as "skipped: email provider not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="LedgerFlow <no-reply@example.com>"

# ---------------------------------------------------------------- tests
# Integration tests (npm run test:integration) need a separate database.
TEST_DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ledgerflow_test
TEST_DATABASE_URL=postgresql://ledgerflow_app:CHANGE_ME@localhost:5432/ledgerflow_test
